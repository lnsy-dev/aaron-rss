# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.DS_Store
prompts/

# Runtime data
pids
*.pid
*.seed

# Coverage / instrumentation
coverage
*.lcov
.nyc_output

# Dependency directories
node_modules/

# Optional npm cache directory
.npm

# Output of 'npm pack'
*.tgz

# dotenv environment variable files
.env
.env.*
!.env.example

